# Copy to .env (never commit .env) and fill from your secret store.

DAGU_USER=admin
DAGU_PASSWORD=change-me

# Entra app registration (client credentials). Application permissions:
#   User.ReadWrite.All, GroupMember.ReadWrite.All, Group.Read.All,
#   LicenseAssignment.ReadWrite.All, DeviceManagementApps.Read.All (only for intune_app mode)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# ServiceDesk Plus technician API key (sent as the "authtoken" header)
SDP_API_KEY=

# Optional: your own public-client app id for graph.auth_mode=device_code
# (defaults to Microsoft Graph Command Line Tools)
# ENTRA_PUBLIC_CLIENT_ID=
